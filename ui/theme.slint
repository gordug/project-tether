export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg_darkest: dark ? #0d1117 : #f0f2f5;
    out property <color> bg_dark: dark ? #161b22 : #ffffff;
    out property <color> bg_card: dark ? #21262d : #f8fafc;
    out property <color> bg_card_hover: dark ? #30363d : #eef2f6;
    out property <color> bg_input: dark ? #0d1117 : #ffffff;
    out property <color> border: dark ? #30363d : #d0d7de;
    out property <color> border_focus: dark ? #58a6ff : #0969da;
    out property <color> progress_track: dark ? #21262d : #e1e4e8;

    out property <color> text_primary: dark ? #f0f6fc : #1f2328;
    out property <color> text_secondary: dark ? #8b949e : #57606a;
    out property <color> text_muted: dark ? #6e7681 : #8c959f;

    // Terminal specific colors (ensures crisp VT100 readability in both app themes)
    out property <color> term_bg: dark ? #090c10 : #141820;
    out property <color> term_toolbar: dark ? #12161f : #1c2230;
    out property <color> term_text: #e6edf3;
    out property <color> term_text_dim: #9ca3af;
    out property <color> term_prompt: #10b981;
    out property <color> term_input_bg: dark ? #10141c : #181d28;

    out property <color> accent: #238636;
    out property <color> accent_hover: #2ea043;
    out property <color> accent_blue: #1f6feb;
    out property <color> accent_blue_hover: #388bfd;
    out property <color> accent_purple: #8957e5;
    out property <color> accent_teal: #1abc9c;
    out property <color> accent_amber: #d29922;
    out property <color> accent_red: #da3633;
    out property <color> accent_red_hover: #f85149;

    // Protocol badge colors
    out property <color> proto_ssh: #388bfd;
    out property <color> proto_telnet: #d29922;
    out property <color> proto_sftp: #2ea043;
    out property <color> proto_scp: #1abc9c;
    out property <color> proto_ftp: #f0883e;
    out property <color> proto_vnc: #39c5bb;
    out property <color> proto_rdp: #a371f7;

    out property <length> radius_sm: 4px;
    out property <length> radius_md: 6px;
    out property <length> radius_lg: 8px;
    out property <length> radius_full: 9999px;
}
