import { Theme } from "../theme.slint";
import { ScrollView, LineEdit, Button } from "std-widgets.slint";

export component TerminalView inherits Rectangle {
    in property <[string]> lines;
    in property <string> prompt_str: "admin@tether:~$ ";
    in-out property <string> current_input: "";

    callback submit_input(string);
    callback run_quick_cmd(string);
    callback clear_screen();

    background: #090c10;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Terminal Toolbar / Quick Commands
        Rectangle {
            height: 38px;
            background: #12161f;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                // Terminal title & indicator
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #10b981;
                }

                Text {
                    text: "VT100 Console (UTF-8 / xterm-256color)";
                    color: Theme.text_secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Quick Command Pills
                for cmd in ["help", "uptime", "top", "df -h", "ping", "matrix"] : Rectangle {
                    height: 22px;
                    background: cmd_touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;

                    cmd_touch := TouchArea {
                        clicked => {
                            root.run_quick_cmd(cmd);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: cmd;
                            color: Theme.accent_blue;
                            font-size: 10px;
                            font-family: "monospace";
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Clear button
                Rectangle {
                    width: 58px;
                    height: 22px;
                    background: clear_touch.has_hover ? Theme.accent_red_hover.with-alpha(0.2) : Theme.bg_card;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;

                    clear_touch := TouchArea {
                        clicked => { root.clear_screen(); }
                    }

                    Text {
                        text: "Clear";
                        color: Theme.accent_red;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Toolbar separator
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Terminal Screen Output
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 2px;

                for line in root.lines: Text {
                    text: line;
                    color: #d1d5db;
                    font-size: 12px;
                    font-family: "monospace";
                    wrap: no-wrap;
                }
            }
        }

        // Input bar separator
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Active Interactive Input Line
        Rectangle {
            height: 42px;
            background: #10141c;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.prompt_str;
                    color: #10b981;
                    font-size: 12px;
                    font-weight: 700;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                input_box := TextInput {
                    horizontal-stretch: 1;
                    text <=> root.current_input;
                    color: #ffffff;
                    font-size: 12px;
                    font-family: "monospace";
                    vertical-alignment: center;

                    accepted => {
                        if self.text != "" {
                            root.submit_input(self.text);
                            self.text = "";
                        }
                    }
                }

                Rectangle {
                    width: 64px;
                    height: 26px;
                    border-radius: Theme.radius_sm;
                    background: send_touch.has_hover ? Theme.accent_hover : Theme.accent;

                    send_touch := TouchArea {
                        clicked => {
                            if input_box.text != "" {
                                root.submit_input(input_box.text);
                                input_box.text = "";
                            }
                        }
                    }

                    Text {
                        text: "Send ↵";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
