import { Theme } from "../theme.slint";
import { TabItem } from "../models.slint";
import { Switch } from "std-widgets.slint";

export component SessionTab inherits Rectangle {
    in property <TabItem> tab;
    callback clicked();
    callback close_clicked();

    height: 38px;
    background: tab.is_active ? Theme.bg_darkest : (tab_touch.has_hover ? Theme.bg_card : Theme.bg_dark);
    border-radius: Theme.radius_sm;
    border-width: 1px;
    border-color: tab.is_active ? Theme.border : Colors.transparent;

    tab_touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Top active indicator line
    Rectangle {
        y: 0px;
        height: 2px;
        width: 100%;
        background: root.tab.is_active ? Theme.accent_blue : Colors.transparent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        // Protocol badge
        Rectangle {
            width: 34px;
            height: 20px;
            border-radius: 3px;
            background: root.tab.badge_color.with-alpha(0.25);

            Text {
                text: root.tab.protocol;
                color: root.tab.badge_color;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Title
        Text {
            text: root.tab.title;
            color: root.tab.is_active ? Theme.text_primary : Theme.text_secondary;
            font-size: 12px;
            font-weight: root.tab.is_active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        // Close Tab button
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: close_touch.has_hover ? Theme.border : Colors.transparent;

            close_touch := TouchArea {
                clicked => { root.close_clicked(); }
            }

            Text {
                text: "✕";
                color: close_touch.has_hover ? Theme.accent_red : Theme.text_muted;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component HeaderBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <int> active_tab_index: -1;
    in property <string> quick_connect_input: "";

    callback tab_selected(int);
    callback tab_closed(int);
    callback quick_connect_submit(string);
    callback quick_connect_changed(string);
    callback dark_mode_toggled(bool);

    height: 44px;
    background: Theme.bg_dark;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 12px;

        // Tabs container
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: start;

            for tab[i] in root.tabs: SessionTab {
                tab: tab;
                clicked => { root.tab_selected(i); }
                close_clicked => { root.tab_closed(i); }
            }
        }

        // Quick Connect Bar & Dark Mode Switch
        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            Rectangle {
                width: 220px;
                height: 30px;
                y: 7px;
                background: Theme.bg_input;
                border-radius: Theme.radius_sm;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        text: "⚡";
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    qc_input := TextInput {
                        text: root.quick_connect_input;
                        color: Theme.text_primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        edited => {
                            root.quick_connect_changed(self.text);
                        }
                        accepted => {
                            root.quick_connect_submit(self.text);
                        }
                    }
                }
            }

            Rectangle {
                width: 72px;
                height: 30px;
                y: 7px;
                border-radius: Theme.radius_sm;
                background: qc_btn.has_hover ? Theme.accent_blue_hover : Theme.accent_blue;

                qc_btn := TouchArea {
                    clicked => { root.quick_connect_submit(qc_input.text); }
                }

                Text {
                    text: "Quick Run";
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Dark Mode Switch: directly two-way bound to Theme.dark
            dark_mode_switch := Switch {
                y: 6px;
                text: Theme.dark ? "🌙 Dark" : "☀️ Light";
                checked <=> Theme.dark;
                accessible-role: switch;
                accessible-label: "Dark mode switch";
                toggled => {
                    root.dark_mode_toggled(Theme.dark);
                }
            }
        }
    }
}
