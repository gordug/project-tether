import { Theme } from "theme.slint";
import { HostItem, TabItem, ServerMetrics, FileItem, TransferItem, VaultEntry } from "models.slint";
import { Sidebar } from "components/sidebar.slint";
import { HeaderBar } from "components/header.slint";
import { Workspace } from "components/workspace.slint";
import { NewHostDialog } from "components/new_host_dialog.slint";
import { VaultDialog } from "components/vault_dialog.slint";

export { Theme, HostItem, TabItem, ServerMetrics, FileItem, TransferItem, VaultEntry }

export global AppState {
    in property <[HostItem]> hosts;
    in property <int> selected_host_index: -1;
    in property <[TabItem]> tabs;
    in property <int> active_tab_index: -1;
    in property <bool> has_active_tab: false;
    in property <TabItem> active_tab;
    in property <ServerMetrics> metrics;
    in-out property <bool> show_new_host_dialog: false;
    in property <string> search_text: "";
    in property <int> category_filter: 0;

    // Terminal State
    in property <[string]> terminal_lines;
    in property <string> terminal_prompt: "admin@tether:~$ ";

    // File Manager State
    in property <string> local_path: "/";
    in property <[FileItem]> local_files;
    in property <int> selected_local_index: -1;
    in property <string> remote_path: "/";
    in property <[FileItem]> remote_files;
    in property <int> selected_remote_index: -1;
    in property <[TransferItem]> transfers;

    // Vault State
    in-out property <bool> show_vault_dialog: false;
    in property <bool> vault_unlocked: false;
    in property <string> vault_error_msg: "";
    in property <[VaultEntry]> vault_entries;
}

export global AppLogic {
    callback host_selected(int);
    callback host_connect(int);
    callback tab_selected(int);
    callback tab_closed(int);
    callback search_changed(string);
    callback filter_changed(int);
    callback quick_connect_submit(string);
    callback quick_connect_protocol(string);
    callback open_new_host_modal();
    callback cancel_new_host_modal();
    callback save_new_host(string, string, string, string, string, string, string);
    callback refresh_session();
    callback disconnect_session();
    callback dark_mode_toggled(bool);

    // Terminal callbacks
    callback terminal_input_submitted(string);
    callback terminal_quick_cmd(string);
    callback terminal_clear_requested();

    // File Manager callbacks
    callback local_folder_enter(int);
    callback local_folder_up();
    callback local_refresh();
    callback local_file_clicked(int);
    callback remote_folder_enter(int);
    callback remote_folder_up();
    callback remote_refresh();
    callback remote_file_clicked(int);
    callback remote_new_folder();
    callback upload_selected();
    callback download_selected();
    callback clear_transfers();

    // Vault callbacks
    callback open_vault();
    callback close_vault();
    callback unlock_vault(string);
    callback lock_vault();
    callback save_vault_secret(string, string);
}

export component AppWindow inherits Window {
    title: "Tether - Remote Management & Monitoring Workbench";
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1200px;
    preferred-height: 780px;
    background: Theme.bg_darkest;

    HorizontalLayout {
        // Left Column: Host Navigation Sidebar
        Rectangle {
            width: 330px;
            Sidebar {
                hosts: AppState.hosts;
                selected_host_index: AppState.selected_host_index;
                search_text: AppState.search_text;
                category_filter: AppState.category_filter;

                host_selected(idx) => { AppLogic.host_selected(idx); }
                host_connect(idx) => { AppLogic.host_connect(idx); }
                search_changed(query) => { AppLogic.search_changed(query); }
                filter_changed(cat) => { AppLogic.filter_changed(cat); }
                new_host_clicked => { AppLogic.open_new_host_modal(); }
                vault_clicked => { AppLogic.open_vault(); }
            }
        }

        // Right Column: Header Tabs + Active Workspace
        VerticalLayout {
            horizontal-stretch: 1;

            HeaderBar {
                tabs: AppState.tabs;
                active_tab_index: AppState.active_tab_index;
                tab_selected(idx) => { AppLogic.tab_selected(idx); }
                tab_closed(idx) => { AppLogic.tab_closed(idx); }
                quick_connect_submit(query) => { AppLogic.quick_connect_submit(query); }
                dark_mode_toggled(is_dark) => { AppLogic.dark_mode_toggled(is_dark); }
            }

            Workspace {
                vertical-stretch: 1;
                has_active_tab: AppState.has_active_tab;
                active_tab: AppState.active_tab;
                metrics: AppState.metrics;

                // Terminal
                terminal_lines: AppState.terminal_lines;
                terminal_prompt: AppState.terminal_prompt;
                terminal_input_submitted(cmd) => { AppLogic.terminal_input_submitted(cmd); }
                terminal_quick_cmd(cmd) => { AppLogic.terminal_quick_cmd(cmd); }
                terminal_clear_requested => { AppLogic.terminal_clear_requested(); }

                // File Manager
                local_path: AppState.local_path;
                local_files: AppState.local_files;
                selected_local_index: AppState.selected_local_index;
                remote_path: AppState.remote_path;
                remote_files: AppState.remote_files;
                selected_remote_index: AppState.selected_remote_index;
                transfers: AppState.transfers;

                local_folder_enter(idx) => { AppLogic.local_folder_enter(idx); }
                local_folder_up => { AppLogic.local_folder_up(); }
                local_refresh => { AppLogic.local_refresh(); }
                local_file_clicked(idx) => { AppLogic.local_file_clicked(idx); }

                remote_folder_enter(idx) => { AppLogic.remote_folder_enter(idx); }
                remote_folder_up => { AppLogic.remote_folder_up(); }
                remote_refresh => { AppLogic.remote_refresh(); }
                remote_file_clicked(idx) => { AppLogic.remote_file_clicked(idx); }
                remote_new_folder => { AppLogic.remote_new_folder(); }

                upload_selected => { AppLogic.upload_selected(); }
                download_selected => { AppLogic.download_selected(); }
                clear_transfers => { AppLogic.clear_transfers(); }

                // Top Session controls
                disconnect_session => { AppLogic.disconnect_session(); }
                reconnect_session => { AppLogic.refresh_session(); }
                quick_connect_protocol(proto) => { AppLogic.quick_connect_protocol(proto); }
            }
        }
    }

    // Modal Overlays
    if AppState.show_new_host_dialog : NewHostDialog {
        cancel_clicked => {
            AppLogic.cancel_new_host_modal();
        }
        save_clicked => {
            AppLogic.save_new_host(
                self.form_name,
                self.form_protocol,
                self.form_host,
                self.form_port,
                self.form_username,
                self.form_group,
                self.form_tags
            );
        }
    }

    if AppState.show_vault_dialog : VaultDialog {
        is_unlocked: AppState.vault_unlocked;
        unlock_error_msg: AppState.vault_error_msg;
        vault_entries: AppState.vault_entries;

        unlock_clicked(password) => {
            AppLogic.unlock_vault(password);
        }
        lock_clicked => {
            AppLogic.lock_vault();
        }
        close_clicked => {
            AppLogic.close_vault();
        }
        save_secret_clicked(host_id, secret) => {
            AppLogic.save_vault_secret(host_id, secret);
        }
    }
}
