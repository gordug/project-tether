export struct HostItem {
    id: string,
    name: string,
    group_name: string,
    protocol: string,
    host: string,
    port: int,
    username: string,
    tags: string,
    notes: string,
    last_connected: string,
    is_favorite: bool,
    badge_color: color,
    status_text: string,
    status_color: color,
}

export struct TabItem {
    id: string,
    host_id: string,
    title: string,
    protocol: string,
    badge_color: color,
    is_active: bool,
}

export struct ServerMetrics {
    cpu_usage: float,
    mem_usage: float,
    disk_usage: float,
    ping_ms: int,
    uptime_str: string,
    load_avg: string,
}

export struct FileItem {
    name: string,
    path: string,
    is_dir: bool,
    size_str: string,
    modified_str: string,
    permissions: string,
    icon: string,
    is_selected: bool,
}

export struct TransferItem {
    id: string,
    name: string,
    source: string,
    destination: string,
    progress: float,
    size_str: string,
    speed_str: string,
    is_upload: bool,
    status: string,
}

export struct VaultEntry {
    host_id: string,
    host_name: string,
    username: string,
    auth_type: string,
    has_secret: bool,
}
